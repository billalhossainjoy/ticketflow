Project TicketFlow_MVP {
  database_type: 'PostgreSQL'
  Note: 'Reviewed MVP draft. Better Auth mapping requires generated-schema verification. Checks, partial indexes, and transaction rules described in notes must be implemented in migrations and application code.'
}

// ====================
// Authentication
// ====================

Table users {
  id uuid [pk]
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null, default: false]
  image text
  is_organizer boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Better Auth user model. Configure UUID generation and table/column mappings. is_organizer is server-controlled with input:false. Use one consistent email normalization and uniqueness policy.'
}

Table accounts {
  id uuid [pk]
  user_id uuid [not null]
  account_id text [not null]
  provider_id text [not null]
  password text [note: 'Password hash, never plaintext']
  access_token text
  refresh_token text
  id_token text
  access_token_expires_at timestamptz
  refresh_token_expires_at timestamptz
  scope text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
  }

  Note: 'Managed by Better Auth. OAuth fields are unused in the email/password-only MVP. Reconcile indexes, constraints, and credential storage with generated schema.'
}

Table sessions {
  id uuid [pk]
  user_id uuid [not null]
  token text [not null, unique]
  expires_at timestamptz [not null]
  ip_address text
  user_agent text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    expires_at
  }

  Note: 'Managed by Better Auth. Tokens are sensitive; never expose them in ordinary logs or business responses.'
}

Table verifications {
  id uuid [pk]
  identifier text [not null]
  value text [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    identifier
    expires_at
  }

  Note: 'Managed by Better Auth. identifier is not a user_id foreign key. Verify token storage and expiry behavior against the configured library version.'
}

// ====================
// Events
// ====================

Enum event_status {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

Table events {
  id uuid [pk]
  organizer_id uuid [not null]
  title text [not null]
  description text [not null]
  venue_name text [not null]
  venue_address text [not null]
  city text [not null]
  country_code varchar(2) [not null]
  timezone text [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  status event_status [not null, default: 'DRAFT']
  version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    organizer_id
    (status, starts_at, id)
  }

  Note: 'Require nonblank title, ends_at > starts_at, and version >= 1. Validate IANA timezone and country code. Publication requires complete details and future start. Updates compare and increment version. Cancellation workflow is deferred.'
}

Table ticket_types {
  id uuid [pk]
  event_id uuid [not null]
  name text [not null]
  price_cents integer [not null]
  currency varchar(3) [not null, default: 'USD']
  sales_start_at timestamptz [not null]
  sales_end_at timestamptz [not null]
  is_active boolean [not null, default: true]
  version integer [not null, default: 1]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    event_id
    (id, event_id) [unique]
  }

  Note: 'Require nonblank name, positive bounded price_cents, currency = USD, sales_start_at < sales_end_at, and version >= 1. Coordinate sales_end_at <= event starts_at transactionally. Sales start inclusive; end exclusive. Updates compare and increment version.'
}

// ====================
// Inventory and reservations
// ====================

Enum booking_status {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

Table ticket_inventory {
  ticket_type_id uuid [pk]
  total_quantity integer [not null]
  reserved_quantity integer [not null, default: 0]
  sold_quantity integer [not null, default: 0]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Require all counters >= 0 and reserved_quantity + sold_quantity <= total_quantity. Use overflow-safe arithmetic in checks. Availability is calculated. Create alongside ticket type in one transaction. Mutations belong to Bookings.'
}

Table bookings {
  id uuid [pk]
  customer_id uuid [not null]
  event_id uuid [not null]
  ticket_type_id uuid [not null]
  quantity integer [not null]
  unit_price_cents integer [not null]
  total_cents integer [not null]
  currency varchar(3) [not null, default: 'USD']
  status booking_status [not null, default: 'PENDING']
  expires_at timestamptz [not null]
  confirmed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (id, customer_id) [unique]
    (customer_id, created_at, id)
    (event_id, status)
    (ticket_type_id, status)
    (status, expires_at)
  }

  Note: 'Require quantity BETWEEN 1 AND 5, positive bounded prices, total_cents = quantity * unit_price_cents using overflow-safe arithmetic, currency = USD, and expires_at > created_at. Quantity and prices are immutable snapshots. Add partial UNIQUE(customer_id,event_id) WHERE status = PENDING in PostgreSQL. Transition expired pending rows before replacement reservations. Confirmation, inventory, and ticket issuance commit atomically.'
}

Table booking_requests {
  id uuid [pk]
  customer_id uuid [not null]
  idempotency_key text [not null]
  request_hash text [not null]
  booking_id uuid [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]

  indexes {
    (customer_id, idempotency_key) [unique]
    expires_at
  }

  Note: 'Persist atomically with successful reservation. Composite FK ensures customer matches booking owner. Same key/payload returns original booking; different payload conflicts. Failed reservations are re-evaluated. Bound key length, require expires_at > created_at, and define retention/reuse policy.'
}

// ====================
// Payments
// ====================

Enum payment_status {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

Table payment_attempts {
  id uuid [pk]
  booking_id uuid [not null]
  stripe_payment_intent_id text [unique]
  provider_idempotency_key text [not null, unique]
  amount_cents integer [not null]
  currency varchar(3) [not null, default: 'USD']
  status payment_status [not null, default: 'CREATED']
  failure_code text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    booking_id
    (id, booking_id) [unique]
    (status, updated_at)
  }

  Note: 'Stripe test mode. Require positive amount and USD matching booking snapshot. Persist before external call; reuse stable provider key for the same operation. Reconcile ambiguous results and missing provider IDs. Local statuses summarize processing, not every Stripe status. A successful payment alone does not confirm a booking.'
}

Table booking_confirmations {
  booking_id uuid [pk]
  payment_attempt_id uuid [not null, unique]
  confirmed_at timestamptz [not null, default: `now()`]

  Note: 'Records the accepted payment for this booking. Composite FK ensures payment belongs to booking. Create with CONFIRMED transition, inventory transfer, and admission tickets in one transaction. confirmed_at must match booking confirmed_at. Do not overwrite on duplicate or extra payments.'
}

// ====================
// Durable webhook inbox
// ====================

Enum webhook_status {
  RECEIVED
  PROCESSING
  PROCESSED
  NEEDS_REVIEW
}

Table payment_webhook_events {
  id uuid [pk]
  stripe_event_id text [not null, unique]
  event_type text [not null]
  stripe_object_id text [not null]
  payload jsonb [not null]
  status webhook_status [not null, default: 'RECEIVED']
  attempt_count integer [not null, default: 0]
  next_attempt_at timestamptz
  locked_until timestamptz
  claim_token uuid
  last_error_code text
  received_at timestamptz [not null, default: `now()`]
  processed_at timestamptz

  indexes {
    (status, next_attempt_at)
    (status, locked_until)
  }

  Note: 'Accept only signature-verified, expected-environment events. Require attempt_count >= 0. PROCESSING requires claim_token and locked_until. Renew/complete/retry only with matching claim token. Recover expired leases. Handle duplicates and reordering through business-state guards. Bound payload size and define retention.'
}

// ====================
// Admission tickets
// ====================

Enum admission_ticket_status {
  VALID
  VOID
}

Table admission_tickets {
  id uuid [pk]
  booking_id uuid [not null]
  ticket_number integer [not null]
  status admission_ticket_status [not null, default: 'VALID']
  issued_at timestamptz [not null, default: `now()`]

  indexes {
    (booking_id, ticket_number) [unique]
  }

  Note: 'Issue one ticket per admission in confirmation transaction. Require ticket_number BETWEEN 1 AND 5; application enforces number <= booking quantity and exact ticket count. Customer access checks booking ownership. QR check-in and transfers deferred.'
}

// ====================
// Recovery refunds
// ====================

Enum refund_status {
  REQUESTED
  PROCESSING
  SUCCEEDED
  NEEDS_REVIEW
}

Table payment_refunds {
  id uuid [pk]
  payment_attempt_id uuid [not null, unique]
  stripe_refund_id text [unique]
  provider_idempotency_key text [not null, unique]
  amount_cents integer [not null]
  currency varchar(3) [not null, default: 'USD']
  reason text [not null]
  status refund_status [not null, default: 'REQUESTED']
  attempt_count integer [not null, default: 0]
  next_attempt_at timestamptz
  locked_until timestamptz
  claim_token uuid
  last_error_code text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (status, next_attempt_at)
    (status, locked_until)
  }

  Note: 'Full recovery refunds for late or extra successful payments. Require positive amount matching payment, USD, nonblank reason, and attempt_count >= 0. PROCESSING requires claim_token and locked_until. Guard worker updates with claim token. Reconcile uncertain external outcomes; provider idempotency is not permanent. NEEDS_REVIEW requires operator action. Ordinary customer refunds deferred.'
}

// ====================
// Relationships
// ====================

// Authentication

Ref: accounts.user_id > users.id [delete: cascade]
Ref: sessions.user_id > users.id [delete: cascade]

// Event ownership and configuration

Ref: events.organizer_id > users.id [delete: restrict]

Ref: ticket_types.event_id > events.id [delete: restrict]

// One-to-one: second side holds the foreign key.

Ref: ticket_types.id - ticket_inventory.ticket_type_id [delete: restrict]

// Reservations

Ref: bookings.customer_id > users.id [delete: restrict]

Ref: bookings.(ticket_type_id, event_id) > ticket_types.(id, event_id) [delete: restrict]

// One request record per booking; customer must match.

Ref: bookings.(id, customer_id) - booking_requests.(booking_id, customer_id) [delete: restrict]

// Payments

Ref: payment_attempts.booking_id > bookings.id [delete: restrict]

// One confirmation per booking.

Ref: bookings.id - booking_confirmations.booking_id [delete: restrict]

// Accepted payment must belong to the same booking.
// Each payment can confirm at most one booking.

Ref: payment_attempts.(id, booking_id) - booking_confirmations.(payment_attempt_id, booking_id) [delete: restrict]

// Tickets can only reference a booking with a confirmation record.

Ref: admission_tickets.booking_id > booking_confirmations.booking_id [delete: restrict]

// One full recovery refund record per payment.

Ref: payment_attempts.id - payment_refunds.payment_attempt_id [delete: restrict]
